.terraformrc
terraform.rc

# Environment files and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# IDE configuration
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
*.log

# Temporary files
*.tmp
*.swp
